# ==============================================================================
# FRONTEND CONFIGURATION (Vite Client)
# Safe for browser exposure (VITE_* prefixed variables are bundled into client code)
# ==============================================================================

# Backend API URL:
# For GitHub Pages deployments, set this to your hosted backend API URL.
# Example: VITE_API_URL="https://your-production-backend.example.com"
# During local development, leaving this empty defaults to relative /api requests.
VITE_API_URL=""

# Supabase Public Client Credentials (Anon Key):
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# ==============================================================================
# BACKEND / SERVER-SIDE CONFIGURATION ONLY (Express / Node.js in server.ts)
# CRITICAL: DO NOT EXPOSE TO CLIENT / BROWSER BUNDLE
# GitHub Pages CANNOT run these credentials or the Node server.
# ==============================================================================

PORT="3001"
APP_URL="http://localhost:3001"

# Supabase Server-Side Credentials:
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"

# Confidential Server Service-Role Key (NEVER expose to browser bundle):
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# SMTP Mail Relay (Brevo / Nodemailer - Server-only):
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user-here"
SMTP_PASS="your-smtp-password-here"
SMTP_FROM="ADMITTO <your-verified-email@example.com>"
