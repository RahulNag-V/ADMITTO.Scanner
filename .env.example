# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3001"

# SUPABASE CONFIGURATION:
# Connect your PostgreSQL/Supabase project here.
# Client-side public credentials (Anon Key):
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Server-side canonical credentials:
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
# Server-side confidential credentials (Service Role Key - DO NOT EXPOSE TO BROWSER):
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# SMTP CONFIGURATION (Brevo / Nodemailer):
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user-here"
SMTP_PASS="your-smtp-password-here"
SMTP_FROM="ADMITTO <your-verified-email@example.com>"
